{
  "permissions": {
    "deny": ["Agent(intent-guard)", "Agent(intent-guard-reporter)"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/intent_guard.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/intent_guard.py"],
            "timeout": 90,
            "onFailure": "block"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/intent_guard.py"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/intent_guard.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/intent_guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
