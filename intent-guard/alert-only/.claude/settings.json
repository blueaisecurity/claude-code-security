{
  "permissions": {
    "deny": ["Agent(intent-guard-reporter)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/refusal_alert.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/refusal_alert.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
